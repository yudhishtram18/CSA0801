import sys
import types
import json
import os

banking = types.ModuleType('banking')
sys.modules['banking'] = banking

file_handler = types.ModuleType('banking.file_handler')
sys.modules['banking.file_handler'] = file_handler
banking.file_handler = file_handler

auth = types.ModuleType('banking.auth')
sys.modules['banking.auth'] = auth
banking.auth = auth

operations = types.ModuleType('banking.operations')
sys.modules['banking.operations'] = operations
banking.operations = operations

def _setup_file_handler():
    DATA_FILE = "accounts.json"
    
    def load_accounts():
        if not os.path.exists(DATA_FILE):
            return {}
        try:
            with open(DATA_FILE, "r") as f:
                return json.load(f)
        except json.JSONDecodeError:
            return {}
            
    def save_accounts(accounts):
        with open(DATA_FILE, "w") as f:
            json.dump(accounts, f, indent=4)
            
    file_handler.load_accounts = load_accounts
    file_handler.save_accounts = save_accounts

_setup_file_handler()

def _setup_auth():
    from banking.file_handler import load_accounts, save_accounts
    
    def create_account(account_number, name, pin, initial_deposit):
        accounts = load_accounts()
        
        if account_number in accounts:
            return False, "Account number already exists."
            
        if initial_deposit < 0:
            return False, "Initial deposit cannot be negative."
            
        accounts[account_number] = {
            "name": name,
            "pin": pin,
            "balance": float(initial_deposit)
        }
        
        save_accounts(accounts)
        return True, "Account created successfully."
        
    def login(account_number, pin):
        accounts = load_accounts()
        
        if account_number not in accounts:
            return False, "Account not found."
if accounts[account_number]["pin"] == pin:
            print("Login SUCCESSFUL")
            
            return True, accounts[account_number]["name"]
        
    auth.create_account = create_account
    auth.login = login

#_setup_auth()

def _setup_operations():
    from banking.file_handler import load_accounts, save_accounts
    
    def check_balance(account_number):
        accounts = load_accounts()
        return float(accounts[account_number]["balance"])
        
    def deposit(account_number, amount):
        if amount <= 0:
            return False, "Amount must be greater than zero."
            
        accounts = load_accounts()
        accounts[account_number]["balance"] += amount
        save_accounts(accounts)
        return True, f"Successfully deposited {amount:.2f}."
        
    def withdraw(account_number, amount):
        if amount <= 0:
            return False, "Amount must be greater than zero."
            
        accounts = load_accounts()
        if accounts[account_number]["balance"] < amount:
            return False, "Insufficient balance."
            
        accounts[account_number]["balance"] -= amount
        save_accounts(accounts)
        return True, f"Successfully withdrew {amount:.2f}."
        
    operations.check_balance = check_balance
    operations.deposit = deposit
    operations.withdraw = withdraw
    
#_setup_operations()

