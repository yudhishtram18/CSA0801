import csv


# ============================================================
# FILE HANDLER
# ============================================================

FILES = {
    "customers": "customers.csv",
    "restaurants": "restaurants.csv",
    "foods": "food_items.csv",
    "orders": "orders.csv",
}


def _write(path, header, rows):
    with open(path, "w", newline="", encoding="utf-8") as handle:
        writer = csv.writer(handle)
        writer.writerow(header)
        writer.writerows(rows)


def _read(path):
    with open(path, newline="", encoding="utf-8") as handle:
        return list(csv.DictReader(handle))


def save_all(customers, restaurants, foods, orders):
    _write(
        FILES["customers"],
        ["ID", "Name", "Location", "City"],
        [
            [
                cid,
                x["name"],
                x["address"][0],
                x["address"][1]
            ]
            for cid, x in customers.items()
        ]
    )

    _write(
        FILES["restaurants"],
        ["ID", "Name", "Location"],
        [
            [rid, x["name"], x["location"]]
            for rid, x in restaurants.items()
        ]
    )

    _write(
        FILES["foods"],
        ["Code", "Name", "Category", "Price", "Restaurant"],
        [
            [
                code,
                x["name"],
                x["category"],
                x["price"],
                x["restaurant"]
            ]
            for code, x in foods.items()
        ]
    )

    _write(
        FILES["orders"],
        [
            "Customer",
            "Restaurant",
            "Food",
            "Quantity",
            "Status",
            "Subtotal",
            "Discount",
            "Delivery",
            "Total"
        ],
        [
            [
                x["customer"],
                x["restaurant"],
                x["food"],
                x["quantity"],
                x["status"],
                x["subtotal"],
                x["discount"],
                x["delivery"],
                x["total"]
            ]
            for x in orders
        ]
    )

    print("All records saved successfully.")


def load_all():
    customers = {}
    restaurants = {}
    foods = {}
    orders = []
    cuisines = set()

    try:
        for row in _read(FILES["customers"]):
            customers[row["ID"]] = {
                "name": row["Name"],
                "address": (
                    row["Location"],
                    row["City"]
                )
            }
    except FileNotFoundError:
        pass

    try:
        for row in _read(FILES["restaurants"]):
            restaurants[row["ID"]] = {
                "name": row["Name"],
                "location": row["Location"]
            }
    except FileNotFoundError:
        pass

    try:
        for row in _read(FILES["foods"]):
            foods[row["Code"]] = {
                "name": row["Name"],
                "category": row["Category"],
                "price": float(row["Price"]),
                "restaurant": row["Restaurant"]
            }

            cuisines.add(row["Category"])

    except FileNotFoundError:
        pass

    try:
        for row in _read(FILES["orders"]):
            orders.append({
                "customer": row["Customer"],
                "restaurant": row["Restaurant"],
                "food": row["Food"],
                "quantity": int(row["Quantity"]),
                "status": row["Status"],
                "subtotal": float(row["Subtotal"]),
                "discount": float(row["Discount"]),
                "delivery": float(row["Delivery"]),
                "total": float(row["Total"])
            })

    except FileNotFoundError:
        pass

    return customers, restaurants, foods, orders, cuisines


