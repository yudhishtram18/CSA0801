def add_customer(customers):
    customer_id = input("Enter customer ID: ").strip()

    if not customer_id:
        print("Customer ID cannot be empty.")
        return

    if customer_id in customers:
        print("Customer already exists.")
        return

    name = input("Enter customer name: ").strip().title()
    location = input("Enter location: ").strip().title()
    city = input("Enter city: ").strip().title()

    customers[customer_id] = {
        "name": name,
        "address": (location, city)
    }

    print("Customer added successfully.")


def find_customer(customers):
    key = input("Enter customer name to search: ").strip().casefold()
    matches = []

    for cid, info in customers.items():
        if key in info["name"].casefold():
            matches.append((cid, info))

    if not matches:
        print("No matching customer found.")
        return

    for cid, info in matches:
        location, city = info["address"]

        print(
            f"ID: {cid} | Name: {info['name']} | "
            f"Location: {location}, {city}"
        )


