def add_food(foods, cuisines, restaurants):
    code = input("Enter food code: ").strip().upper()

    if code in foods:
        print("Food item already exists.")
        return

    rid = input("Enter restaurant ID: ").strip().upper()

    if rid not in restaurants:
        print("Restaurant does not exist.")
        return

    name = input("Enter food name: ").strip().title()
    category = input(
        "Enter cuisine category: "
    ).strip().title()

    if not name or not category:
        print("Food name and category are required.")
        return

    try:
        price = float(input("Enter price: "))
    except ValueError:
        print("Price must be numeric.")
        return

    if price <= 0:
        print("Price must be positive.")
        return

    foods[code] = {
        "name": name,
        "category": category,
        "price": price,
        "restaurant": rid
    }

    cuisines.add(category)

    print("Food item added successfully.")


def list_food(foods, restaurants):
    if not foods:
        print("No food items available.")
        return

    print("\n--- FOOD MENU ---")

    for code, item in foods.items():
        rid = item["restaurant"]

        restaurant = restaurants.get(
            rid, {"name": "Unknown"}
        )["name"]

        print(
            f"{code}: {item['name']} | "
            f"{item['category']} | "
            f"{restaurant} | "
            f"Rs. {item['price']:.2f}"
        )


# ============================================================
# ORDER MANAGEMENT
# ============================================================

class OrderError(Exception):
    pass


def _bill(price, qty):
    subtotal = price * qty

    rate = (
        0.10
        if subtotal >= 1000
        else 0.05
        if subtotal >= 500
        else 0
    )

    discount = subtotal * rate
    delivery = 40.0

    return (
        subtotal,
        discount,
        delivery,
        subtotal - discount + delivery
    )


def place_order(customers, restaurants, foods, orders):
    cid = input("Enter customer ID: ").strip()

    if cid not in customers:
        raise OrderError("Customer ID does not exist")

    code = input("Enter food code: ").strip().upper()

    if code not in foods:
        raise OrderError("Food code does not exist")

    food = foods[code]
    rid = food["restaurant"]

    if rid not in restaurants:
        raise OrderError("Restaurant record is missing")

    try:
        qty = int(input("Enter quantity: "))

        if qty < 1:
            raise ValueError

    except ValueError:
        raise OrderError(
            "Quantity must be a positive integer"
        )

    subtotal, discount, delivery, total = _bill(
        food["price"], qty
    )

    orders.append({
        "customer": cid,
        "restaurant": rid,
        "food": code,
        "quantity": qty,
        "status": "Pending",
        "subtotal": subtotal,
        "discount": discount,
        "delivery": delivery,
        "total": total
    })

    print("Order created successfully.")
    print(
        f"Restaurant: {restaurants[rid]['name']}"
    )
    print(f"Food: {food['name']}")
    print(f"Final amount: Rs. {total:.2f}")


def list_orders(customers, restaurants, foods, orders):
    if not orders:
        print("No orders available.")
        return

    print("\n--- ORDER HISTORY ---")

    for number, order in enumerate(orders, start=1):

        cname = customers.get(
            order["customer"], {}
        ).get("name", "Unknown")

        rname = restaurants.get(
            order["restaurant"], {}
        ).get("name", "Unknown")

        fname = foods.get(
            order["food"], {}
        ).get("name", "Unknown")

        print(
            f"{number}. {cname} | {rname} | {fname} | "
            f"Qty:{order['quantity']} | "
            f"{order['status']} | "
            f"Rs.{order['total']:.2f}"
        )


def update_status(orders):
    if not orders:
        print("There are no orders.")
        return

    for i, item in enumerate(orders, start=1):
        print(i, item["food"], item["status"])

    try:
        index = int(
            input("Enter order number: ")
        ) - 1

        if index not in range(len(orders)):
            raise ValueError

    except ValueError:
        print("Invalid order number.")
        return

    allowed = (
        "Pending",
        "Confirmed",
        "Preparing",
        "Delivered",
        "Cancelled"
    )

    status = input(
        "Enter new status: "
    ).strip().title()

    if status not in allowed:
        print("Invalid status.")
        return

    orders[index]["status"] = status

    print("Order status updated.")


# ============================================================
# ANALYSIS
# ============================================================

def _total_for(customer_id, orders):
    return sum(
        item["total"]
        for item in orders
        if item["customer"] == customer_id
    )


def customer_spending(customers, orders):
    cid = input("Enter customer ID: ").strip()

    if cid not in customers:
        print("Customer not found.")
        return

    amount = _total_for(cid, orders)

    print(
        f"{customers[cid]['name']} has ordered goods "
        f"worth Rs. {amount:.2f}"
    )


def compare_order_totals(orders):
    if len(orders) < 2:
        print("At least two orders are required.")
        return

    try:
        first = int(
            input("Enter first order number: ")
        ) - 1

        second = int(
            input("Enter second order number: ")
        ) - 1

        if (
            first not in range(len(orders))
            or second not in range(len(orders))
        ):
            raise ValueError

    except ValueError:
        print("Invalid order number.")
        return

    a = orders[first]["total"]
    b = orders[second]["total"]

    if a == b:
        print("Both orders have equal value.")
    elif a > b:
        print("First order has the higher value.")
    else:
        print("Second order has the higher value.")


# ============================================================
# REPORT GENERATION
# ============================================================

def build_report(
    customers,
    restaurants,
    foods,
    orders,
    cuisines
):
    print("\n========== FOOD ORDER REPORT ==========")

    print("Customers:", len(customers))
    print("Restaurants:", len(restaurants))
    print("Food items:", len(foods))
    print("Orders:", len(orders))

    sales = sum(
        item["total"]
        for item in orders
    )

    status_count = {}
    restaurant_sales = {}

    for item in orders:
        status = item["status"]

        status_count[status] = status_count.get(
            status, 0
        ) + 1

        rid = item["restaurant"]

        restaurant_sales[rid] = (
            restaurant_sales.get(rid, 0)
            + item["total"]
        )

    print(f"Total sales: Rs. {sales:.2f}")

    print("\nORDER STATUS")

    for status, count in sorted(
        status_count.items()
    ):
        print(status, ":", count)

    print("\nRESTAURANT PERFORMANCE")

    for rid, amount in restaurant_sales.items():

        name = restaurants.get(
            rid, {}
        ).get("name", "Unknown")

        print(
            f"{name}: Rs. {amount:.2f}"
        )

    print("\nCUISINE CATEGORIES")

    for category in sorted(cuisines):
        print("-", category)


