def add_restaurant(restaurants):
    rid = input("Enter restaurant ID: ").strip().upper()

    if rid in restaurants:
        print("Restaurant already exists.")
        return

    name = input("Enter restaurant name: ").strip().title()
    location = input("Enter restaurant location: ").strip().title()

    if not name or not location:
        print("Restaurant name and location are required.")
        return

    restaurants[rid] = {
        "name": name,
        "location": location
    }

    print("Restaurant added successfully.")


def find_restaurant(restaurants):
    term = input(
        "Enter restaurant name to search: "
    ).strip().casefold()

    result = [
        (rid, info)
        for rid, info in restaurants.items()
        if term in info["name"].casefold()
    ]

    if not result:
        print("No matching restaurant found.")
        return

    for rid, info in result:
        print(
            f"ID: {rid} | {info['name']} | {info['location']}"
        )


def list_restaurants(restaurants):
    if not restaurants:
        print("No restaurants available.")
        return

    print("\n--- RESTAURANT LIST ---")

    for rid, info in restaurants.items():
        print(
            f"{rid}: {info['name']} ({info['location']})"
        )


